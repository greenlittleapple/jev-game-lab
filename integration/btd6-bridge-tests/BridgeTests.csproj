<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the bridge's protocol code (integration/btd6-bridge/Protocol), which has no game
       references. Runs without the game: dotnet run -c Release (or npm run btd6:bridge-test). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\btd6-bridge\Protocol\*.cs" Link="Protocol\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
