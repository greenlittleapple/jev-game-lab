# Copy to .env. Never paste the key into chat or commit .env.
TYPESAFE_API_KEY=
# Hard caps for one btd6:run session, required for a live run: decisions (with or without a Jev
# call; forced screen dismissals don't count) and Jev input tokens. The runner stops when either is reached.
MAX_DECISIONS=
MAX_INPUT_TOKENS=
# The BTD6 install folder (<BTD6 dir>), for the mods on/off script and the bridge build.
BTD6_DIR=
# Where the mods script keeps the loader files while mods are off (default .private/btd6/mods-off).
# It must be on the same drive as BTD6_DIR.
# BTD6_MODS_BACKUP_DIR=
# Port the bridge CLI and runner connect to (default 15527). The mod's own port is in
# <BTD6 dir>/UserData/MelonPreferences.cfg under [JevBtd6Bridge].
# BTD6_BRIDGE_PORT=15527
# Port of the btd6:run status page on 127.0.0.1 (default 4318; 4317 is the STS2 dashboard).
# BTD6_STATUS_PORT=4318
# 1: refuse to play unless the bridge reports unlock_all (every tower and upgrade available). Off by
# default: the account's own unlocks apply.
# BTD6_REQUIRE_ALL_UNLOCKS=1
